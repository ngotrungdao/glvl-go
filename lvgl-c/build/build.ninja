# Utility command for install/strip

build _deps/sdl2-build/CMakeFiles/install/strip.util: CUSTOM_COMMAND _deps/sdl2-build/all
  COMMAND = cd /__w/lvgl/lvgl/build/_deps/sdl2-build && /usr/sbin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build _deps/sdl2-build/install/strip: phony _deps/sdl2-build/CMakeFiles/install/strip.util


